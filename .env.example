# Copy to .env.local for local development, and add the same values in
# Vercel → Project → Settings → Environment Variables for production.
# All of these are public (they end up in the browser bundle) — none are secrets.

# REQUIRED for sign-ups. Your Formspree form endpoint.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id

# Optional. Google Analytics 4 measurement ID. Leave empty to disable analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional. Your production URL (used for SEO + share previews).
# On Vercel this falls back to the project's production domain automatically.
NEXT_PUBLIC_SITE_URL=

# Optional. Shown on the privacy page as a contact for data/unsubscribe requests.
NEXT_PUBLIC_CONTACT_EMAIL=
